{
  "name": "minimal-downloader",
  "version": "1.1.3",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "release:win": "electron-builder --win nsis --publish never"
  },
  "build": {
    "files": [
      "**/*",
      "!dist/**",
      "!dist-preview/**",
      "!dist-preview-next/**",
      "!dist-preview-ui/**",
      "!catalog.json*",
      "!artwork/**",
      "!game-metadata.json*",
      "!game-identities.json*",
      "!steam-search.json*",
      "!library-state.json*",
      "!issues.json*",
      "!**/*.log",
      "!downloads.json*",
      "!torbox-availability.json*",
      "!torbox-openapi.tmp.json",
      "!test/**",
      "!vendor/**",
      "!config.json*",
      "!themes.json*",
      "!.github/**"
    ],
    "extraFiles": [
      {
        "from": "ADD-GAME.cmd",
        "to": "ADD-GAME.cmd"
      },
      {
        "from": "helper/run.ps1",
        "to": "MambaHelper.ps1"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/7zip",
        "to": "7zip",
        "filter": [
          "7z.exe",
          "7z.dll",
          "License.txt",
          "readme.txt"
        ]
      }
    ],
    "appId": "com.mamba.launcher",
    "productName": "Mamba",
    "publish": [
      {
        "provider": "github",
        "owner": "shall0e",
        "repo": "Mamba",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Mamba-Setup-${version}.${ext}",
      "icon": "assets/mamba.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/mamba.ico",
      "uninstallerIcon": "assets/mamba.ico",
      "installerHeaderIcon": "assets/mamba.ico"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "description": "A desktop game library and TorBox downloader",
  "productName": "Mamba"
}
