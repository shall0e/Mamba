{
  "name": "minimal-downloader",
  "version": "1.3.0",
  "private": true,
  "main": "src/main/index.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "release:win": "electron-builder --win nsis --publish never",
    "format": "prettier --write src tools test config package.json README.md docs",
    "format:check": "prettier --check src tools test config package.json README.md docs"
  },
  "build": {
    "files": [
      "src/**/*",
      "assets/mamba.png",
      "assets/mamba.ico",
      "assets/mamba-mask.png",
      "assets/mamba-background-mask.png",
      "assets/LUCIDE-LICENSE",
      "tools/add-game.cjs",
      "tools/helper/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "tools/ADD-GAME.cmd",
        "to": "ADD-GAME.cmd"
      },
      {
        "from": "tools/helper/run.ps1",
        "to": "MambaHelper.ps1"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/7zip",
        "to": "7zip",
        "filter": [
          "7z.exe",
          "7z.dll",
          "License.txt",
          "readme.txt"
        ]
      }
    ],
    "appId": "com.mamba.launcher",
    "productName": "Mamba",
    "publish": [
      {
        "provider": "github",
        "owner": "shall0e",
        "repo": "Mamba",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Mamba-Setup-${version}.${ext}",
      "icon": "assets/mamba.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/mamba.ico",
      "uninstallerIcon": "assets/mamba.ico",
      "installerHeaderIcon": "assets/mamba.ico"
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "description": "A desktop game library and TorBox downloader",
  "productName": "Mamba"
}
